# O banco. Sem ela o servidor não sobe — não existe modo de demonstração.
#
# Local (depois de `npm run banco:subir`):
DATABASE_URL=postgres://caixa:caixa@localhost:3432/caixa_vivo

# Em produção, a URL do Postgres do provedor. TLS é ligado sozinho quando o
# host não é localhost; PGSSL=0 desliga, para um Postgres interno sem certificado.
# PGSSL=0

# Porta do servidor. Em produção o provedor injeta a dele.
PORT=3402

# Só para `npm test`, se o banco de teste for outro. Sem ela, os testes usam
# DATABASE_URL, e sem nenhuma das duas caem no Postgres local do docker-compose.
# DATABASE_URL_TESTE=postgres://caixa:caixa@localhost:3432/caixa_vivo_teste
