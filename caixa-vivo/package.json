{
  "name": "caixa-vivo",
  "version": "1.0.0",
  "private": true,
  "description": "Caixa Vivo — o caixa da noite do clube de poker, registrado enquanto acontece.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:tela": "vite",
    "dev:api": "tsx watch servidor/index.ts",
    "build": "tsc -b && vite build && npm run build:servidor",
    "build:servidor": "esbuild servidor/index.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --log-level=warning --outfile=dist-servidor/index.js && esbuild banco/criar-operador.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --log-level=warning --outfile=dist-servidor/criar-operador.js",
    "start": "node dist-servidor/index.js",
    "migrar-e-subir": "node banco/migrar.mjs && node dist-servidor/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "provas": "vitest run testes/provas",
    "banco:subir": "docker compose up -d",
    "banco:derrubar": "docker compose down",
    "banco:migrar": "node banco/migrar.mjs",
    "banco:semear": "node banco/semear.mjs",
    "banco:operador": "tsx banco/criar-operador.ts",
    "verificar": "npm run build && node scripts/verificar-dados-reais.mjs",
    "verificar-tudo": "bash scripts/verificar-tudo.sh",
    "banco:operador:prod": "node dist-servidor/criar-operador.js",
    "banco:semear:prod": "node banco/semear.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.11.3",
    "lucide-react": "^0.554.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
